# Skopiuj do .env (nie commituj .env).
DATABASE_URL=sqlite:///./stylnauki.db

# Sekret do podpisywania tokenów JWT: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Opcjonalne — katalog na wgrywane pliki (domyślnie backend/uploads)
# MEDIA_ROOT=

# Opcjonalne — generator materiałów AI dla nauczyciela.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
